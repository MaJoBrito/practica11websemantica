@base <http://localhost:8000/producto.ttl> .
@prefix :        <#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gr: <http://purl.org/goodrelations/v1#> .
@prefix schema: <https://schema.org/> .

# Descripción del documento
<> a foaf:Document ;
    dcterms:title "Documento sobre Kia Niro Hybrid" ;
    dcterms:description "Una colección de tripletas RDF que describen a un producto identificad como 'Kia Niro Hybrid'" ;
    foaf:primaryTopic :Niro .

# Descripción de María
:Niro a gr:ProductOrService ;
    foaf:name "Kia Niro Hybrid" ;
    foaf:img <img/Niro.jpg> ;
    foaf:maker <empresa.ttl#Kia> ;
    gr:hasManufacturer <empresa.ttl#Kia> .